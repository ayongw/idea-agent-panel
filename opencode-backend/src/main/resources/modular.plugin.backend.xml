<idea-plugin>
    <id>opencode-idea-panel.opencode-backend</id>
    <name>OpenCode Backend Module</name>
    <vendor url="https://github.com/ayongw">AYongW</vendor>

    <dependencies>
        <module name="intellij.platform.backend"/>
        <module name="intellij.platform.kernel.backend"/>
        <module name="opencode-idea-panel.opencode-shared"/>
    </dependencies>

    <extensions defaultExtensionNs="com.intellij">
        <platform.rpc.backend.remoteApiProvider implementation="com.ayongw.plugins.opencode.backend.BackendRpcApiProvider"/>
    </extensions>
</idea-plugin>